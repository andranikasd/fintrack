# Production VPS setup: copy to .env, fill the first two values, then:
# docker compose up -d --build
BOT_TOKEN=123456789:replace-with-your-botfather-token
# Numeric Telegram user ID, not a username. Multiple IDs may be comma-separated.
ALLOWED_USER_IDS=123456789
DEFAULT_TZ=Asia/Yerevan
BACKUP_RETENTION_DAYS=7

# Cloudflare deployment only (not needed by Docker):
# WORKER_URL=https://fintrack.your-subdomain.workers.dev
# WEBHOOK_SECRET=generate-a-long-random-string

# Optional live dashboard. Leave empty to receive interactive HTML files in Telegram.
# With your existing HTTPS reverse proxy:
# DASHBOARD_URL=https://fintrack.example.com
# Or use compose.dashboard.yaml for automatic HTTPS:
# DASHBOARD_HOST=fintrack.example.com
